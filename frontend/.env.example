# Base da API do SaúdePlus. Copie este arquivo para `.env` se precisar.
#
#   cd frontend && cp .env.example .env
#
# Vazio (padrão): o front chama `/api/...` e, em desenvolvimento, o Vite faz
# proxy para o back-end em http://localhost:8080 (ver vite.config.js).
# Para apontar para outro servidor, informe a URL sem o `/api`, por exemplo:
#   VITE_API_URL=https://api.saudeplus.exemplo
# Nesse caso a origem do front precisa estar liberada no CORS do back-end
# (propriedade `saudeplus.cors.origens`).
VITE_API_URL=
