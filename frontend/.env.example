# Base da API do SaúdePlus. Copie este arquivo para `.env` e ajuste se
# o back-end não estiver na porta padrão.
#
#   cd frontend && cp .env.example .env
#
# O back-end sobe em 8080 (backend/src/main/resources/application.yml) e
# libera esta origem no CORS (backend/.../config/CorsConfig.java).
VITE_API_URL=http://localhost:8080
